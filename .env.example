KANBAN_BIND_ADDRESS=127.0.0.1
KANBAN_PUBLISH_PORT=8787
# Set the external HTTPS origin when using a reverse proxy.
# KANBAN_PUBLIC_ORIGIN=https://dashboard.example.com
# To terminate HTTPS inside this one container (Linux Compose):
# COMPOSE_FILE=compose.yaml:compose.tls.yaml
# KANBAN_TLS_DIR=/etc/sub2api-monitor/tls
# The directory contains fullchain.pem and privkey.pem, readable by UID 1000.
# KANBAN_BIND_ADDRESS=0.0.0.0
# KANBAN_PUBLISH_PORT=8443
# KANBAN_PUBLIC_ORIGIN=https://dashboard.example.com:8443
KANBAN_ALLOW_HTTP=false
KANBAN_CACHE_MS=30000
# Optional registry/mirror for the official Node base image.
# KANBAN_NODE_IMAGE=node:22-alpine
# Native Node only; must be outside this source directory.
# KANBAN_DATA_DIR=/var/lib/sub2api-monitor
