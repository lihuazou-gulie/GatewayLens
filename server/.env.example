NODE_ENV=production
RUNTIME_HOST=127.0.0.1
RUNTIME_PORT=8787

# Optional direct HTTPS mode. Set both paths together when the BFF is exposed
# on a public high port without Nginx.
RUNTIME_TLS_CERT_FILE=
RUNTIME_TLS_KEY_FILE=

# Required. Keep the real value on the server; it must never be placed in src/ or public JS.
RUNTIME_UPSTREAM_BASE_URL=https://your-upstream.example

# Set only the server-side credential required by the upstream.
RUNTIME_UPSTREAM_PUBLIC_VIEW_KEY=
RUNTIME_UPSTREAM_API_KEY=

# Optional independent token for viewers. Leave empty only when the dashboard is intentionally public.
RUNTIME_VIEW_TOKEN=

# Restrict this to the sites that are allowed to embed the dashboard. Use '*'
# only when every embedding origin is intentionally allowed.
RUNTIME_FRAME_ANCESTORS='self' https://your-embed-host.example
RUNTIME_REQUEST_TIMEOUT_MS=8000
RUNTIME_HISTORY_CACHE_MS=60000
